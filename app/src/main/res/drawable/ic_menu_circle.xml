<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Circle background -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#6200EE"/>
            <size android:width="56dp" android:height="56dp"/>
        </shape>
    </item>
    <!-- Hamburger lines -->
    <item android:top="16dp" android:bottom="16dp" android:left="14dp" android:right="14dp">
        <layer-list>
            <item android:top="0dp" android:bottom="16dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF"/>
                    <corners android:radius="2dp"/>
                    <size android:height="3dp"/>
                </shape>
            </item>
            <item android:top="8dp" android:bottom="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF"/>
                    <corners android:radius="2dp"/>
                    <size android:height="3dp"/>
                </shape>
            </item>
            <item android:top="16dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF"/>
                    <corners android:radius="2dp"/>
                    <size android:height="3dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>
