<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Semi-transparent white/grey fill to show touch area -->
    <solid android:color="#40888888" />
    
    <!-- Subtle border -->
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
        
    <!-- Note: The existing backgroundTint in code might override this if not handled carefully.
         Better to use this as the base background and let the tint apply color or use layers.
         Actually, the button icon itself has color. This background is for the "area". -->
</shape>
