<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/menu_bg"
    android:padding="16dp"
    android:elevation="16dp"
    android:minWidth="300dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Übersetzer (KI)"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quelltext (Zwischenablage):"
        android:textSize="12sp"
        android:textColor="#666"/>
        
    <EditText
        android:id="@+id/sourceTextPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="8"
        android:hint="Text zum Übersetzen eingeben..."
        android:gravity="top|start"
        android:padding="8dp"
        android:background="#EEE"
        android:textSize="14sp"
        android:layout_marginBottom="4dp"/>

    <Button
        android:id="@+id/btnClearSource"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="Leeren"
        android:textSize="12sp"
        android:backgroundTint="#999999"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Zielsprache:"
        android:textSize="12sp"/>

    <Spinner
        android:id="@+id/languageSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnStartTranslate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Senden"
        android:backgroundTint="#FF6200EE"/>

    <ProgressBar
        android:id="@+id/translateProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <EditText
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="3"
        android:maxLines="6"
        android:hint="Übersetzung erscheint hier..."
        android:gravity="top|start"
        android:background="@android:drawable/edit_text"
        android:layout_marginTop="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnCopyResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kopieren"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnInsertResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Einfügen"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btnCloseDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Schließen"
        android:backgroundTint="#888888"
        android:layout_marginTop="8dp"/>

</LinearLayout>
